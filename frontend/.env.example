# Copie para .env. URL base da API do Build-Plan (backend).
VITE_API_URL=http://localhost:3333/api

# Referência regional do autocomplete SINAPI (deve bater com SINAPI_UF_PADRAO /
# SINAPI_REGIME_PADRAO do backend). Opcional — defaults: SC / NAO_DESONERADO.
# VITE_SINAPI_UF=SC
# VITE_SINAPI_REGIME=NAO_DESONERADO
