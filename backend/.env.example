

# Servidor
PORT=3333
NODE_ENV=development

# Banco de dados (Postgres do docker-compose)
DATABASE_URL="postgresql://buildplan:buildplan_dev_password@localhost:5432/buildplan_db?schema=public"

# Autenticação
JWT_SECRET="troque-por-uma-string-secreta-forte"
JWT_EXPIRES_IN="8h"

# Referência SINAPI da precificação automática (src/config/sinapi.config.ts).
# Opcionais — defaults: SC, 09/2026, NAO_DESONERADO.
# SINAPI_UF_PADRAO=SC
# SINAPI_MES_PADRAO=9
# SINAPI_ANO_PADRAO=2026
# SINAPI_REGIME_PADRAO=NAO_DESONERADO
