

# Servidor
PORT=3333
NODE_ENV=development

# Banco de dados (Postgres do docker-compose)
DATABASE_URL="postgresql://buildplan:buildplan_dev_password@localhost:5432/buildplan_db?schema=public"

# Autenticação
# Em produção: mínimo de 32 caracteres e a API recusa valores de exemplo.
JWT_SECRET="troque-por-uma-string-secreta-forte"
JWT_EXPIRES_IN="8h"

# CORS: origens do frontend autorizadas, separadas por vírgula (nunca "*").
# Default (fora de produção): http://localhost:5173
# Em produção é obrigatória, com https:// (ver deploy/README.md).
CORS_ORIGINS="http://localhost:5173"

# Nº de proxies reversos confiáveis à frente da API (define o IP do cliente
# usado pelo rate limit). Default: 1 em produção (Nginx), 0 fora dela.
# TRUST_PROXY=0

# E-mail (recuperação de senha). Sem SMTP_HOST nada é enviado: em
# desenvolvimento o link de redefinição aparece no console da API.
# SMTP_HOST=smtp.seu-provedor.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_REMETENTE="Build-Plan <nao-responda@seu-dominio.com>"
# Endereço do frontend usado nos links dos e-mails.
# Default: a primeira origem de CORS_ORIGINS.
# FRONTEND_URL="http://localhost:5173"

# Referência SINAPI da precificação automática (src/config/sinapi.config.ts).
# Opcionais — defaults: SC, 09/2026, NAO_DESONERADO.
# SINAPI_UF_PADRAO=SC
# SINAPI_MES_PADRAO=9
# SINAPI_ANO_PADRAO=2026
# SINAPI_REGIME_PADRAO=NAO_DESONERADO
