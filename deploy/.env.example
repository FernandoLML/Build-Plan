# Caminho: /deploy/.env.example
# Copie para deploy/.env NA EC2 (nunca versione o .env) e preencha.
# Gere os segredos na própria máquina:
#   openssl rand -hex 24    -> POSTGRES_PASSWORD (hex: seguro dentro da URL)
#   openssl rand -base64 48 -> JWT_SECRET

# --- Postgres ---
POSTGRES_USER=buildplan
POSTGRES_DB=buildplan
POSTGRES_PASSWORD=

# --- API ---
# Mínimo de 32 caracteres; a API recusa valores de exemplo em produção.
JWT_SECRET=
JWT_EXPIRES_IN=8h

# URL(s) do frontend na Vercel: com https://, tudo em minúsculas e sem barra
# no final. Várias origens: separe por vírgula.
# A API não inicia com um valor inválido aqui. Se o frontend ainda não foi
# publicado, deixe o valor abaixo e troque pela URL real depois (passo 7).
CORS_ORIGINS=https://seu-projeto.vercel.app

# --- E-mail: recuperação de senha (opcional) ---
# Sem SMTP_HOST a API funciona, mas não envia o link de redefinição de senha.
# Serve qualquer provedor SMTP (Brevo, Amazon SES, Gmail com senha de app...).
# Porta 587 (STARTTLS) ou 465 (TLS). A porta 25 é bloqueada pela AWS.
# SMTP_HOST=smtp.seu-provedor.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_REMETENTE=Build-Plan <nao-responda@seu-dominio.com>
# Endereço do frontend usado no link do e-mail. Default: a 1ª de CORS_ORIGINS.
# FRONTEND_URL=https://seu-projeto.vercel.app

# --- Observabilidade (opcional) ---
# Senha do usuário "admin" do Grafana (openssl rand -hex 16).
# GRAFANA_ADMIN_PASSWORD=
# Mantém Prometheus e Grafana ligados em todo `docker compose up -d`,
# inclusive nos deploys automáticos.
# COMPOSE_PROFILES=observability

# --- Imagens (preenchidas pelo deploy.sh; não edite à mão) ---
# API_IMAGE=
# TOOLS_IMAGE=

# --- SINAPI (opcionais; estes são os defaults) ---
# SINAPI_UF_PADRAO=SC
# SINAPI_MES_PADRAO=9
# SINAPI_ANO_PADRAO=2026
# SINAPI_REGIME_PADRAO=NAO_DESONERADO
