      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum(rate(http_requests_total{job=\"buildplan-api\",status_code=~\"5..\"}[$__rate_interval])) / sum(rate(http_requests_total{job=\"buildplan-api\"}[$__rate_interval])) or vector(0)",
